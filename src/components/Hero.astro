---
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden grain">
  <!-- Background image with deep overlay -->
  <div class="absolute inset-0" style="background-image: url('/header-bg.jpg'); background-size: cover; background-position: center;"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-gray-950/80 via-gray-950/70 to-gray-950/90"></div>

  <!-- Geometric accent shapes -->
  <div class="absolute top-20 left-10 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl"></div>
  <div class="absolute bottom-20 right-10 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl"></div>

  <!-- Content -->
  <div class="relative z-10 text-center max-w-5xl mx-auto px-6 pt-24 pb-16">
    <div class="animate-fade-up" style="animation-delay: 0.1s;">
      <span class="section-label text-amber-400 mb-6 inline-block">
        <span class="w-8 h-px bg-amber-400 inline-block mr-3 align-middle"></span>
        Data-Driven Solutions
        <span class="w-8 h-px bg-amber-400 inline-block ml-3 align-middle"></span>
      </span>
    </div>

    <h1 class="animate-fade-up text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-extrabold text-white mb-6 tracking-tight leading-[0.95]" style="animation-delay: 0.25s;">
      Welcome to<br />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-amber-200">Dattam Labs</span>
    </h1>

    <p class="animate-fade-up text-lg md:text-xl text-white/60 mb-10 max-w-2xl mx-auto leading-relaxed" style="animation-delay: 0.4s;">
      We transform data into insights and ideas into reality through innovative technology solutions.
    </p>

    <div class="animate-fade-up flex flex-col sm:flex-row items-center justify-center gap-4" style="animation-delay: 0.55s;">
      <a href="#services" class="btn-primary">
        Explore Services
        <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m19 12-7 7-7-7m14-6-7 7-7-7"/></svg>
      </a>
      <a href="#contact" class="btn-outline">
        Get in Touch
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <div class="w-6 h-10 rounded-full border-2 border-white/30 flex items-start justify-center p-1.5">
      <div class="w-1.5 h-3 bg-white/50 rounded-full"></div>
    </div>
  </div>
</section>
