---
---

<section class="relative pt-32 pb-20 md:pt-40 md:pb-28 px-6 bg-gray-950 overflow-hidden">
  <!-- Subtle background accents -->
  <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-amber-500/5 rounded-full blur-3xl -translate-y-1/2"></div>
  <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-blue-600/5 rounded-full blur-3xl translate-y-1/2"></div>

  <div class="max-w-7xl mx-auto relative z-10">
    <div class="max-w-3xl">
      <span class="section-label text-amber-400 mb-5 inline-block">Dattam Labs</span>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-white mb-6 tracking-tight leading-[1.1]" style="font-family: 'Outfit', sans-serif;">
        We transform data into insights and ideas into reality.
      </h1>
      <p class="text-lg text-white/50 mb-8 max-w-2xl leading-relaxed">
        An IT consultancy specializing in public data analysis, AI/ML systems, DevOps, and cloud-native application development.
      </p>
      <div class="flex flex-col sm:flex-row items-start gap-4">
        <a href="#services" class="btn-primary">
          Explore Services
          <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5m7-7 7 7-7 7"/></svg>
        </a>
        <a href="#contact" class="btn-outline">
          Get in Touch
        </a>
      </div>
    </div>

    <!-- Inline social proof -->
    <div class="mt-16 pt-8 border-t border-white/[0.08]">
      <p class="text-xs font-bold tracking-[0.15em] uppercase text-white/30 mb-5">Trusted by</p>
      <div class="flex flex-wrap items-center gap-8 md:gap-12">
        <img src="/clients/chartr_logo.jpg" alt="Chartr logo" width="100" height="40" loading="eager" class="h-8 w-auto brightness-0 invert opacity-40" />
        <img src="/clients/pradhilogo.jpg" alt="Pradhi logo" width="100" height="40" loading="eager" class="h-8 w-auto brightness-0 invert opacity-40" />
        <img src="/clients/ceewlogo.jpg" alt="CEEW logo" width="100" height="40" loading="eager" class="h-8 w-auto brightness-0 invert opacity-40" />
        <img src="/clients/startechlogo.png" alt="StarTech365 logo" width="100" height="40" loading="eager" class="h-8 w-auto brightness-0 invert opacity-40" />
      </div>
    </div>
  </div>
</section>
