---
import { mapPinIcon, mailIcon } from '../icons';
import { LINKS } from '../config';
---

<section id="contact" class="py-28 px-6 bg-gray-50 scroll-mt-20">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <span class="section-label mb-4 inline-block">Let's Talk</span>
      <h2 class="section-heading text-gray-900 mb-5">Get in Touch</h2>
      <p class="text-lg text-gray-500 max-w-xl mx-auto">Ready to transform your data into actionable insights? We'd love to hear from you.</p>
    </div>

    <div class="grid md:grid-cols-2 gap-8 max-w-3xl mx-auto">
      <!-- Location card -->
      <div class="bg-white border border-gray-200 rounded-2xl p-8 shadow-sm hover:shadow-lg transition-all duration-500">
        <div class="w-12 h-12 bg-amber-50 rounded-xl flex items-center justify-center mb-5">
          <Fragment set:html={mapPinIcon('w-6 h-6 text-amber-600')} />
        </div>
        <h3 class="text-lg font-bold text-gray-900 mb-3">Our Location</h3>
        <div class="text-gray-500 text-sm leading-relaxed space-y-1">
          <p>Dattam Labs, Awfis, Prestige Skytech</p>
          <p>ISB Rd, behind Continental Hospital</p>
          <p>Financial District, Nanakramguda</p>
          <p>Telangana 500032</p>
        </div>
      </div>

      <!-- Email card -->
      <div class="bg-white border border-gray-200 rounded-2xl p-8 shadow-sm hover:shadow-lg transition-all duration-500">
        <div class="w-12 h-12 bg-amber-50 rounded-xl flex items-center justify-center mb-5">
          <Fragment set:html={mailIcon('w-6 h-6 text-amber-600')} />
        </div>
        <h3 class="text-lg font-bold text-gray-900 mb-3">Email Us</h3>
        <a href="mailto:contact@dattam.in" class="text-amber-700 hover:text-amber-800 font-medium transition-colors text-lg">
          contact@dattam.in
        </a>
        <p class="text-gray-400 text-sm mt-2">We typically respond within 24 hours</p>
      </div>
    </div>

    <!-- CTA -->
    <div class="text-center mt-12">
      <a href={LINKS.email} class="btn-primary">
        Start a Conversation
        <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/></svg>
      </a>
    </div>
  </div>
</section>
