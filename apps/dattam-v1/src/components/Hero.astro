<section class="relative pt-32 pb-20 md:pt-40 md:pb-28 px-6 bg-white overflow-hidden">
  <!-- Subtle background accents -->
  <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-amber-500/5 rounded-full blur-3xl -translate-y-1/2"></div>
  <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-blue-600/5 rounded-full blur-3xl translate-y-1/2"></div>

  <div class="max-w-7xl mx-auto relative z-10">
    <div class="max-w-3xl">
      <span class="section-label mb-5 inline-block">Dattam Labs</span>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-gray-900 mb-6 tracking-tight leading-[1.1]" style="font-family: 'Outfit', sans-serif;">
        We transform data into insights and ideas into reality.
      </h1>
      <p class="text-lg text-gray-500 mb-8 max-w-2xl leading-relaxed">
        We build open data datasets, agentic AI tools, data visualizations, and scalable cloud infrastructure.
      </p>
      <div class="flex flex-col sm:flex-row items-start gap-4">
        <a href="#services" class="btn-primary">
          Explore Services
          <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5m7-7 7 7-7 7"/></svg>
        </a>
        <a href="#contact" class="inline-flex items-center justify-center gap-2 rounded-lg text-sm font-semibold tracking-wide uppercase px-7 py-3.5 border-2 border-gray-200 hover:border-gray-900 hover:bg-gray-50 text-gray-900 transition-all duration-300">
          Get in Touch
        </a>
      </div>
    </div>
  </div>
</section>
